# Evidara local/deployment environment template
# Copy to .env.local for local development and replace placeholders with real values.
# Never commit real secret values.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy alternative if the project still uses an anon JWT:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Supabase server-only secret. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Cloudflare R2 question/resource storage (server-only except the public base URL)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=replace_me
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://replace_me.example.com
